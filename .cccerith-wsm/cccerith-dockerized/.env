# CCC Erith Parish Docker Configuration
# Copy this file to .env and customize as needed
# All settings have defaults - this file is optional

# Project directory to mount (default: current directory)
# PROJECT_DIR=/home/ccerith/cccerithparish/my-app

# X11 display settings (usually auto-detected by antigravity.sh)
# DISPLAY=:0
# XAUTHORITY=/home/user/.Xauthority
